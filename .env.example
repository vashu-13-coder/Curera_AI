# ---------------------------------------------------------------------------
# CURERA AI — Environment Variables
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# LLM_API_KEY and SUPABASE_SERVICE_ROLE_KEY are SERVER-ONLY.
# Never import them into a client component.
# ---------------------------------------------------------------------------

# Server-only
LLM_API_KEY=

# Optional, server-only
SPEECH_API_KEY=

# LLM model identifier (server-side only).
# Leave empty to use gemini-3.8-flash, or set the exact model name shown in
# Google AI Studio.
LLM_MODEL=

# Safe for the browser (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=